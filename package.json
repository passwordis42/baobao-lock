{
  "name": "baobao-lock",
  "version": "0.1.0",
  "private": true,
  "description": "开会/直播时锁住键盘，鼠标照常用。开机不会自动上锁。",
  "author": "宝宝锁",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icons": "node scripts/build-icons.js",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "app.baobaolock",
    "productName": "BaobaoLock",
    "copyright": "宝宝锁",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "BaobaoLock",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Baobao-Lock-Setup-${version}.${ext}",
      "shortcutName": "宝宝锁",
      "uninstallDisplayName": "宝宝锁",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true,
      "language": "2052",
      "installerLanguages": ["zh_CN"]
    }
  }
}
